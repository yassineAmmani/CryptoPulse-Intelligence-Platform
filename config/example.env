# Kafka / Confluent Cloud
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISMS=PLAIN
KAFKA_SASL_USERNAME=your_confluent_api_key
KAFKA_SASL_PASSWORD=your_confluent_api_secret

# Topics from the architecture diagram
KAFKA_TRADES_TOPIC=trades_topic
KAFKA_NEWS_TOPIC=news_topic
KAFKA_FRED_TOPIC=fred_topic
KAFKA_ALERTS_TOPIC=alerts_topic

# Source APIs
NEWS_API_KEY=your_newsapi_key
FRED_API_KEY=your_fred_api_key

# Binance / News producer settings
BINANCE_SYMBOLS=btcusdt,ethusdt,bnbusdt,solusdt,adausdt
NEWS_QUERY=(bitcoin OR ethereum) AND (price OR trading OR market OR volatility)
NEWS_SOURCES=reuters,bloomberg,cnbc,cointelegraph,financial-times
NEWS_POLL_SECONDS=60

# FRED batch settings
FRED_SERIES=DFF,CPIAUCSL,UNRATE,GDP,PCE,M2SL,PAYEMS,INDPRO,FEDFUNDS,TB3MS
FRED_OBSERVATION_START=2026-01-01

# Spark fan-out sinks
DATA_LAKE_PATH=/mnt/crypto-intelligence/data-lake/enriched
SPARK_CHECKPOINT_PATH=/mnt/crypto-intelligence/checkpoints/main
SUPABASE_JDBC_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_TABLE=crypto_market_intelligence
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=crypto:intelligence
